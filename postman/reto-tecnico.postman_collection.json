      "name": "0 - Autenticación",
      "item": [
        {
          "name": "Obtener token (ejecutar primero)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('token', json.access_token);",
                  "pm.test('Se recibió access_token', () => pm.expect(json.access_token).to.be.a('string'));"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "password"
                },
                {
                  "key": "client_id",
                  "value": "reto-api"
                },
                {
                  "key": "client_secret",
                  "value": "{{clientSecret}}"
                },
                {
                  "key": "username",
                  "value": "{{username}}"
                },
                {
                  "key": "password",
                  "value": "{{password}}"
                }
              ]
            },
            "url": {
              "raw": "{{keycloakUrl}}/realms/reto-realm/protocol/openid-connect/token",
              "host": [
                "{{keycloakUrl}}"
              ],
              "path": [
                "realms",
                "reto-realm",
                "protocol",
                "openid-connect",
                "token"
              ]
            }
          }
        }
      ]
    },
